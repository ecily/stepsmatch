# Set this explicitly in DigitalOcean App/Static Site envs
VITE_API_BASE_URL=https://api.stepsmatch.com/api

# Optional fallback (only used when VITE_API_BASE_URL is missing)
VITE_API_FALLBACK_URL=https://api.stepsmatch.com/api

# Non-sensitive frontend-only pre-alpha access hurdle; not a security boundary.
VITE_TESTER_ACCESS_KEY=PREALPHA-DEMO

# Maps
VITE_GOOGLE_MAPS_API_KEY=<google-maps-api-key>
VITE_GOOGLE_MAPS_MAP_ID=<google-maps-map-id>
