PORT=8080
NODE_ENV=production

# Database
MONGO_URI=<mongodb-connection-string>

# Auth
JWT_SECRET=<strong-random-secret>
ALPHA_MASTER_LOGIN_ENABLED=false
ALPHA_MASTER_EMAIL=
ALPHA_MASTER_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Expo / Push
EXPO_PROJECT_ID=<expo-project-id>
EXPO_ACCESS_TOKEN=<expo-access-token>
EXPO_PUSH_CHANNEL_ID=stepsmatch-nearby-attention-v1
PUSH_CHANNEL_ID=stepsmatch-nearby-attention-v1
PUSH_CATEGORY_ID=offer-go-v2
PUSH_PRIORITY=high
PUSH_SOUND=default

# App / Domains
CORS_ORIGINS=https://stepsmatch.com,https://www.stepsmatch.com,http://localhost:5173,http://localhost:3000
APK_TARGET_URL=<digitalocean-spaces-public-apk-url>

# Optional runtime tuning
OFFER_POLLER_ENABLED=1
DEFAULT_OFFER_RADIUS_M=120
HB_MAX_CHECK_DISTANCE_M=2000
GEOFENCE_RENOTIFY_COOLDOWN_MS=7200000
REENTRY_MIN_GAP_MS=300000
