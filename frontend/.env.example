# Set this explicitly in DigitalOcean App/Static Site envs
VITE_API_BASE_URL=https://stepsmatch.com/api

# Optional fallback (only used when VITE_API_BASE_URL is missing)
VITE_API_FALLBACK_URL=https://www.stepsmatch.com/api

# Maps
VITE_GOOGLE_MAPS_API_KEY=<google-maps-api-key>
VITE_GOOGLE_MAPS_MAP_ID=<google-maps-map-id>
